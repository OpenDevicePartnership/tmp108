device Inner {
    default-byte-order: LE,
    register-address-type: u8,
    word-boundaries: "-_",
    default-access: RW,

    /// Temperature register
    register temperature {
        address: 0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        },
    },

    /// Configuration register
    register configuration {
        address: 1,
        reset: 0x1022,
        fields: fieldset _ {
            size-bytes: 2,

            /// Device functional mode
            field m 1:0 -> _ as try
                /// Device functional mode
                enum Mode {
                    shutdown: 0,
                    one-shot: 1,
                    continuous: 2,
                },
            /// Thermostat mode
            field tm 2 -> _ as
                /// Thermostat mode
                enum Thermostat {
                    comparator: 0,
                    interrupt: 1,
                },
            /// Temperature watchdog low flag
            field fl 3,
            /// Temperature watchdog high flag
            field fh 4,
            /// Conversion rate
            field cr 6:5 -> _ as
                /// Conversion rate
                enum conversion-rate {
                    quarter-hz: 0,
                    one-hz: 1,
                    four-hz: 2,
                    sixteen-hz: 3,
                },
            /// ID
            field id 7,
            /// Hysteresis control
            field hys 13:12 -> _ as
                /// Temperature hysteresis
                enum hysteresis {
                    zero-c: 0,
                    one-c: 1,
                    two-c: 2,
                    four-c: 3,
                },
            /// ALERT pin polarity
            field pol 15 -> _ as
                /// ALERT pin polarity
                enum polarity {
                    active-low: 0,
                    active-high: 1,
                },
        },
    },

    /// Temperature low register
    ///
    /// Power-up default: TLOW = -128 °C (`0x8000`) per datasheet §7.5.4
    /// (`sources/datasheet.txt:994`). Confirmed on silicon (#63).
    register t-low {
        address: 2,
        reset: 0x8000,
        fields: fieldset _ {
            size-bytes: 2,
        },
    },

    /// Temperature high register
    ///
    /// Power-up default: THIGH = +127.9375 °C (`0x7FF8`) per datasheet
    /// §7.5.4 prose (`sources/datasheet.txt:993-994`).
    ///
    /// Table 11 (`sources/datasheet.txt:1004`) shows byte 2's low nibble
    /// as fixed zeros, which would imply `0x7FF0` for the same
    /// temperature. Those two cannot both be canonical. Fresh silicon
    /// reads back `0x7FF8` (bit 3 of the reserved nibble set) at reset,
    /// matching the prose and not Table 11's implied value (#63).
    /// Declare `0x7FF8` deliberately; do not "normalize" the reserved
    /// nibble to zero.
    register t-high {
        address: 3,
        reset: 0x7FF8,
        fields: fieldset _ {
            size-bytes: 2,
        },
    },
}
